<resources>
    <style name="Theme.Jarvis" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="colorOnPrimary">@color/jarvis_bg</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="android:textColorPrimary">@color/jarvis_text</item>
        <item name="android:textColorSecondary">@color/jarvis_muted</item>
        <item name="android:textColorHint">@color/jarvis_muted</item>
    </style>

    <style name="JarvisLabel">
        <item name="android:textColor">@color/jarvis_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="JarvisInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/jarvis_text</item>
        <item name="android:textColorHint">@color/jarvis_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
