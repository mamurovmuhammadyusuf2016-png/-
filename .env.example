# ============================================================================
# Пример конфигурации. Скопируйте в .env и заполните значения:
#   cp .env.example .env
# На Railway/Render те же переменные задаются в разделе Variables.
# ============================================================================

# --- Сервер -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Публичный HTTPS-адрес сервиса (используется скриптами настройки)
PUBLIC_BASE_URL=https://calls.example.com

# --- ГЛАВНЫЙ ПАРАМЕТР: окно тишины -----------------------------------------
# Через сколько минут повторный звонок считается новым обращением и
# соединяется с владельцем. Меняется без правки кода; можно поменять
# на лету через PUT /admin/config {"cooldownMinutes": 30}
CALL_COOLDOWN_MINUTES=40

# Личный номер владельца — на него соединяются «новые обращения».
# Международный формат без плюса либо внутренний номер АТС (например, 100).
OWNER_PHONE=998901112233

# Что делать с повторным звонком внутри окна тишины:
#   ignore — ничего не делаем, звонок идёт по штатному сценарию линии (по ТЗ)
#   hangup — сбрасываем звонок
REPEAT_CALL_ACTION=ignore

# --- Автоответ на первый звонок ---------------------------------------------
# voice — только голосовое сообщение
# sms   — только SMS
# both  — и то, и другое (по умолчанию)
# none  — без автоответа (звонок всё равно не соединяется)
AUTOREPLY_MODE=both

# Язык текстов автоответа: ru | uz
AUTOREPLY_LANGUAGE=ru

# ID аудиофайла, загруженного в личном кабинете Zadarma
# (Мои АТС -> Настройки -> Аудиофайлы). Нужен при AUTOREPLY_MODE=voice|both.
AUTOREPLY_VOICE_FILE_ID=

# Свой текст SMS. Пусто — используется текст по умолчанию из src/domain/messages.js.
# Поддерживается плейсхолдер {{cooldownMinutes}}.
AUTOREPLY_SMS_TEXT=

# Имя отправителя SMS, согласованное с Zadarma (senderid). Пусто — номер по умолчанию.
SMS_SENDER=

# Класть трубку после автоответа, чтобы звонок не ушёл живому сотруднику.
HANGUP_AFTER_AUTOREPLY=true

# Язык встроенных голосовых фраз Zadarma: ru, ua, en, es, pl, fr, de
VOICE_LANGUAGE=ru

# --- Переадресация на владельца ---------------------------------------------
# Сколько секунд звонить владельцу до возврата вызова в сценарий АТС
REDIRECT_RETURN_TIMEOUT=25
# Подпись вместо номера в определителе владельца (опционально)
CALLER_NAME_PREFIX=

# --- Ключи API Zadarma ------------------------------------------------------
# Личный кабинет -> Настройки -> API (ключ и секрет)
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_API_BASE_URL=https://api.zadarma.com
# Проверка подписи входящих вебхуков. В production отключать нельзя.
ZADARMA_VERIFY_SIGNATURE=true
ZADARMA_REQUEST_TIMEOUT_MS=8000
# Виртуальный номер Zadarma (используется только скриптом имитации звонка)
ZADARMA_VIRTUAL_NUMBER=

# --- Хранилище --------------------------------------------------------------
# sqlite (по умолчанию) | memory (только для отладки, данные не сохраняются)
STORE_DRIVER=sqlite
DATABASE_PATH=./data/calls.db
# Сколько дней хранить журнал звонков (0 — хранить всё)
CALL_LOG_RETENTION_DAYS=180

# --- Служебный API и интеграции ---------------------------------------------
# Токен для эндпоинтов /admin/* (обязателен в production).
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Куда дублировать события звонков (Google Sheets через Apps Script, CRM,
# Make/Zapier). Пусто — интеграция выключена.
FORWARD_WEBHOOK_URL=
FORWARD_WEBHOOK_TIMEOUT_MS=5000
